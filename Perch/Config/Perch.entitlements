<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The update check, and nothing else: one hourly GET to
	     api.github.com for the latest release tag, off by a Settings
	     toggle — see Perch/Platform/UpdateCheck.swift. Perch never
	     uploads anything and never fetches a file; a sandboxed app
	     cannot replace its own bundle, so the nudge hands you the
	     command for your install instead of installing anything. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The rice's theme drop: ~/.config/perch/{config.json,themes/*.json},
	     which lives outside the container. Read-only, one directory, and the
	     only path perch reaches for that a drag or a file picker did not hand
	     it — see Perch/UI/Theme/RicePalette.swift. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/.config/perch/</string>
	</array>
</dict>
</plist>
