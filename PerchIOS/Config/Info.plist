<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist; only keys the
	     INFOPLIST_KEY_ build settings can't express live here. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Perch finds your paired Mac on your network to hand it what you put on the shelf. Nothing leaves your network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_perch._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>The camera reads the pairing QR code your Mac shows. It is never used otherwise.</string>
	<!-- Export compliance. Every byte of crypto on the wire (X25519, HKDF,
	     ChaCha20-Poly1305, SHA-256, HMAC) is CryptoKit's — standard algorithms
	     provided by the operating system, nothing proprietary, and no
	     encryption of our own design. Declaring it here means App Store
	     Connect stops asking on every upload. If that reading ever changes,
	     it changes in docs/app-store.md first. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
