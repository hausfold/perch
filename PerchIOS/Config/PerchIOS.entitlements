<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one shared place the app and the Share extension both reach:
	     the phone-side shelf, the outbox, and (via keychain app-group
	     access) the pairing key. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hausfold.perch</string>
	</array>
</dict>
</plist>
